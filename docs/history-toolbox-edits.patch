+	local a extra="" envs=""
+	while IFS= read -r a; do [ -z "$a" ] || extra="$extra'$a' "; done <<<"${TT_SESSION_CLAUDE_ARGS:-}"
+	while IFS= read -r a; do case $a in [A-Za-z_]*=*) envs="$envs${a%%=*}='${a#*=}' " ;; esac; done <<<"${TT_SESSION_EXPORTS:-}"
