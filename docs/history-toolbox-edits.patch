+	while IFS= read -r kv; do
+		case $kv in [A-Za-z_]*=*) printf 'export %s=%q\n' "${kv%%=*}" "${kv#*=}" ;; esac
+	done <<<"${TT_SESSION_EXPORTS:-}"
+	extra=""
+	while IFS= read -r a; do [ -z "$a" ] || extra="$extra $(printf '%q' "$a")"; done <<<"${TT_SESSION_CLAUDE_ARGS:-}"
 	if [ -n "$name" ]; then
-		printf 'exec %q -n %q %q\n' "$claude" "$name" "$prompt"
+		printf 'exec %q%s -n %q %q\n' "$claude" "$extra" "$name" "$prompt"
 	else
-		printf 'exec %q %q\n' "$claude" "$prompt"
+		printf 'exec %q%s %q\n' "$claude" "$extra" "$prompt"
 	fi
 } >"$launcher"
 chmod +x "$launcher"
