+# window <command> ...: the tt window (tt-common/scripts/window.sh). "open" also
+# shows the greeting and where the documents in this folder stand.
+window() {
+	local W="$root/tt-common/scripts/window.sh" rc rows
+	[ -f "$W" ] || { echo "No window in this toolbox (tt-common/scripts/window.sh is missing)." >&2; return 3; }
+	[ "${1:-}" = open ] || { bash "$W" "$@"; return; }
+	bash "$W" "$@"
+	rc=$?
+	[ "$rc" = 0 ] || return "$rc"
+	bash "$TATTY" banner | bash "$W" show text "Tatty"
+	if rows=$(bash "$STATE" --tsv . 2>/dev/null); then
+		printf '%s\n' "$rows" | bash "$W" show table "Where things stand in $(pwd)"
+	fi
+	return 0
+}
+
 cmd=${1:-hello}
 [ $# -gt 0 ] && shift
 case $cmd in
@@ -337,6 +356,7 @@ context) context status "${1:-.}" ;;
