<Window x:Class="TtCompanion.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tatty - window" Width="380" Height="440"
        WindowStyle="None" ResizeMode="NoResize" Background="#F7F6F3"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Left="-32000" Top="-32000">
  <!-- The speech bubble: Tatty's own page, in its compact or full layout.
       Opaque on purpose: WebView2 can't draw inside a transparent window, so the
       rounded corners come from the window manager instead (Native.RoundCorners). -->
  <wv2:WebView2 x:Name="Web" />
</Window>
