<Window x:Class="TtCompanion.TattyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tatty" Width="104" Height="156"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Cursor="Hand" ToolTip="Tatty: click to talk, drag to move, right-click for his menu">
  <!-- Tatty in the page's colours: ◉ ◉ eyes, ▽ mouth, an antenna and ╨ ╨ legs.
       Native drawing only, so the window can be truly transparent.

       He is 104x120 of drawing in a 104x156 window: the window keeps a strip
       above him to jump and lean into and one below him to sit down into, since
       a window clips whatever leaves it. TattyWindow.TopInset and BottomInset
       name those strips, and the bubble is placed off them rather than off the
       window's own edges (App.xaml.cs's PlaceBubbleOnce).

       Every part an animation moves is named, and so is every transform:
       Avatar.cs animates the transforms and nothing else, so this file stays a
       drawing. The root three move all of him (jumping, leaning, squashing),
       Body's two move everything above the knees (the idle bob, a dance sway),
       and each leg has a lift and a fold of its own, so he can shift his weight
       from foot to foot and fold them under to sit. -->
  <Canvas Width="104" Height="156">
    <Canvas x:Name="Robot" Canvas.Top="24" Width="104" Height="120">
      <Canvas.RenderTransform>
        <TransformGroup>
          <!-- about the ground between his feet: he squashes and leans from there -->
          <ScaleTransform x:Name="RootSquash" CenterX="52" CenterY="100" ScaleX="1" ScaleY="1" />
          <RotateTransform x:Name="RootLean" CenterX="52" CenterY="100" Angle="0" />
          <TranslateTransform x:Name="RootLift" />
        </TransformGroup>
      </Canvas.RenderTransform>
      <Canvas.Effect>
        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
      </Canvas.Effect>

      <!-- legs: ╨ ╨, one canvas each so a foot can lift on its own -->
      <Canvas x:Name="LegL">
        <Canvas.RenderTransform>
          <TransformGroup>
            <RotateTransform x:Name="LegLFold" CenterX="38" CenterY="80" Angle="0" />
            <TranslateTransform x:Name="LegLLift" />
          </TransformGroup>
        </Canvas.RenderTransform>
        <Line X1="38" Y1="80" X2="38" Y2="96" Stroke="{DynamicResource TtAccent}" StrokeThickness="4" StrokeEndLineCap="Round" />
        <Line X1="30" Y1="98" X2="46" Y2="98" Stroke="{DynamicResource TtAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Canvas>
      <Canvas x:Name="LegR">
        <Canvas.RenderTransform>
          <TransformGroup>
            <RotateTransform x:Name="LegRFold" CenterX="66" CenterY="80" Angle="0" />
            <TranslateTransform x:Name="LegRLift" />
          </TransformGroup>
        </Canvas.RenderTransform>
        <Line X1="66" Y1="80" X2="66" Y2="96" Stroke="{DynamicResource TtAccent}" StrokeThickness="4" StrokeEndLineCap="Round" />
        <Line X1="58" Y1="98" X2="74" Y2="98" Stroke="{DynamicResource TtAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Canvas>

      <!-- everything above the knees: it bobs and sways while the feet stay put -->
      <Canvas x:Name="Body">
        <Canvas.RenderTransform>
          <TransformGroup>
            <RotateTransform x:Name="BodySway" CenterX="52" CenterY="90" Angle="0" />
            <TranslateTransform x:Name="BodyShift" />
          </TransformGroup>
        </Canvas.RenderTransform>

        <!-- antenna -->
        <Line X1="52" Y1="10" X2="52" Y2="24" Stroke="{DynamicResource TtAccent}" StrokeThickness="3" StrokeStartLineCap="Round" />
        <Ellipse Canvas.Left="47" Canvas.Top="4" Width="10" Height="10" Fill="{DynamicResource TtAccent}" />

        <!-- head -->
        <Rectangle Canvas.Left="18" Canvas.Top="24" Width="68" Height="56" RadiusX="12" RadiusY="12"
                   Fill="#FDFCF9" Stroke="{DynamicResource TtAccent}" StrokeThickness="3" />

        <!-- eyes: ◉ ◉. Blink flattens them, and holds them half or fully shut
             while he dozes and sleeps; the pupils slide to look about. -->
        <Canvas x:Name="Eyes">
          <Canvas.RenderTransform>
            <ScaleTransform x:Name="Blink" CenterY="48" ScaleY="1" />
          </Canvas.RenderTransform>
          <Ellipse Canvas.Left="30" Canvas.Top="39" Width="18" Height="18" Stroke="{DynamicResource TtAccent}" StrokeThickness="2.5" />
          <Ellipse Canvas.Left="56" Canvas.Top="39" Width="18" Height="18" Stroke="{DynamicResource TtAccent}" StrokeThickness="2.5" />
          <Canvas x:Name="Pupils">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="PupilShift" />
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="35" Canvas.Top="44" Width="8" Height="8" Fill="#1F2328" />
            <Ellipse Canvas.Left="61" Canvas.Top="44" Width="8" Height="8" Fill="#1F2328" />
          </Canvas>
        </Canvas>

        <!-- three mouths, one shown at a time: ▽ as a rule, a grin to celebrate
             or yawn with, a flat line asleep. Swapping is cheaper and steadier
             than animating the shape. -->
        <Polygon x:Name="MouthNeutral" Points="47,63 57,63 52,71" Fill="{DynamicResource TtAccent}" />
        <Path x:Name="MouthHappy" Data="M 42,61 Q 52,77 62,61 Z" Fill="{DynamicResource TtAccent}" Visibility="Collapsed" />
        <Line x:Name="MouthFlat" X1="45" Y1="67" X2="59" Y2="67" Visibility="Collapsed"
              Stroke="{DynamicResource TtAccent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

        <!-- something to answer -->
        <Grid x:Name="Badge" Canvas.Left="74" Canvas.Top="12" Width="22" Height="22" Visibility="Collapsed">
          <Ellipse Fill="#C62828" Stroke="White" StrokeThickness="2" />
          <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Canvas>
    </Canvas>
  </Canvas>
</Window>
