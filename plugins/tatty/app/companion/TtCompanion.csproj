<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tatty's tray companion (Windows). A thin shell around the
       page app/server.py serves: the UI itself is app/web. Tatty builds it
       from a copy of these sources in %LOCALAPPDATA%\Tatty\companion. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TtCompanion</AssemblyName>
    <RootNamespace>TtCompanion</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Tatty's face (assets/tatty.ico; the build copies it next to the sources):
         the exe's icon in the shell, and the one the tray and windows load. -->
    <ApplicationIcon>tatty.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="tatty.ico" LogicalName="tatty.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
