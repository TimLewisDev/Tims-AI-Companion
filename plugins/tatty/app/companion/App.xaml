<Application x:Class="TtCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Tatty is drawn in the mode's accent, the same colours as the page
         (app/web/theme.css). TtAccent is swapped for one of the others when the
         page says the mode changed (App.xaml.cs's SetAccent). -->
    <SolidColorBrush x:Key="TtAccent" Color="#3B6EA8" />
    <SolidColorBrush x:Key="TtAccentEngineering" Color="#3B6EA8" />
    <SolidColorBrush x:Key="TtAccentDesign" Color="#A9641F" />
    <SolidColorBrush x:Key="TtAccentProduction" Color="#7D5BBD" />
  </Application.Resources>
</Application>
